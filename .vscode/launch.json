{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Django: Servidor de Desarrollo (Poki Koa)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/src/manage.py",
      "args": ["runserver", "127.0.0.1:8000", "--noreload"],
      "env": {
        "PYTHONPATH": "${workspaceFolder}/src",
        "DJANGO_SETTINGS_MODULE": "poki_koa.settings"
      },
      "django": true,
      "justMyCode": true
    },
    {
      "name": "Django: Servidor Entregable 2 (Datos Demo Aislados)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/src/manage.py",
      "args": [
        "runserver",
        "127.0.0.1:8000",
        "--settings=poki_koa.settings_entregable",
        "--noreload"
      ],
      "env": {
        "PYTHONPATH": "${workspaceFolder}/src"
      },
      "django": true,
      "justMyCode": true
    },
    {
      "name": "Django: Depurar Suite de Pruebas (cunas)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/src/manage.py",
      "args": ["test", "cunas", "-v", "2"],
      "env": {
        "PYTHONPATH": "${workspaceFolder}/src",
        "DJANGO_SETTINGS_MODULE": "poki_koa.settings"
      },
      "django": true,
      "justMyCode": true
    },
    {
      "name": "Unittest: Depurar Pruebas Aisladas (test/)",
      "type": "debugpy",
      "request": "launch",
      "module": "unittest",
      "args": ["discover", "-s", "test", "-v"],
      "env": {
        "PYTHONPATH": "${workspaceFolder}/src"
      },
      "justMyCode": true
    }
  ]
}
