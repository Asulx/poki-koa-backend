meta {
  name: M17 - Consulta para precarga
  type: http
  seq: 85
}

get {
  url: {{base_url}}/api/catalogo-medicamentos/910001/
  body: none
  auth: none
}

headers {
  Content-Type: application/json
}

tests {
  test("HTTP 200", () => expect(res.getStatus()).to.equal(200));
  test("Valor nombre", () => expect(res.getBody()["nombre"]).to.deep.equal("Producto base QA"));
  test("Valor principio_activo", () => expect(res.getBody()["principio_activo"]).to.deep.equal("Sustancia QA"));
  test("Valor dosis_mg", () => expect(res.getBody()["dosis_mg"]).to.deep.equal("1.00"));
  test("Valor stock", () => expect(res.getBody()["stock"]).to.deep.equal(10));
}

docs {
  US-02 / M-CA2
  Negocio: recuperar producto
  Caso M17, paso 1. Ejecutar toda la colección en orden sobre la base restablecida.
}
