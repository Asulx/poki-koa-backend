meta {
  name: B18 - Modificar diagnóstico sin perder otros datos
  type: http
  seq: 43
}

patch {
  url: {{base_url}}/api/bebes/910001/
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "diagnostico": "Observación QA actualizada"
  }
}

tests {
  test("HTTP 200", () => expect(res.getStatus()).to.equal(200));
  test("Valor diagnostico", () => expect(res.getBody()["diagnostico"]).to.deep.equal("Observación QA actualizada"));
  test("Valor identificador", () => expect(res.getBody()["identificador"]).to.deep.equal("QA-BASE-1"));
  test("Valor peso", () => expect(res.getBody()["peso"]).to.deep.equal(3.2));
  test("Valor medico_a_cargo", () => expect(res.getBody()["medico_a_cargo"]).to.deep.equal(910001));
}

docs {
  US-01 / B-CA5
  Negocio: actualización parcial
  Caso B18, paso 1. Ejecutar toda la colección en orden sobre la base restablecida.
}
