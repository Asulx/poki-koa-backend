meta {
  name: B08 - Peso no numérico
  type: http
  seq: 17
}

post {
  url: {{base_url}}/api/bebes/
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "identificador": "QA-B08",
    "nombre_completo": "Paciente ficticio QA",
    "edad_meses": 0,
    "sexo": "F",
    "peso": "abc",
    "fecha_nacimiento": "{{ayer}}",
    "medico_a_cargo": 910001
  }
}

tests {
  test("HTTP 400", () => expect(res.getStatus()).to.equal(400));
  test("Error peso", () => { expect(res.getBody()).to.have.property("peso"); expect(res.getBody()["peso"]).to.not.be.empty; });
}

docs {
  US-01 / B-CA3
  Equivalencia inválida: tipo
  Caso B08, paso 1. Ejecutar toda la colección en orden sobre la base restablecida.
}
