meta {
  name: B16 - Sexo fuera del catálogo
  type: http
  seq: 37
}

post {
  url: {{base_url}}/api/bebes/
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "identificador": "QA-B16",
    "nombre_completo": "Paciente ficticio QA",
    "edad_meses": 0,
    "sexo": "X",
    "peso": 3.2,
    "fecha_nacimiento": "{{ayer}}",
    "medico_a_cargo": 910001
  }
}

tests {
  test("HTTP 400", () => expect(res.getStatus()).to.equal(400));
  test("Error sexo", () => { expect(res.getBody()).to.have.property("sexo"); expect(res.getBody()["sexo"]).to.not.be.empty; });
}

docs {
  US-01 / B-CA2
  Equivalencia inválida: elección
  Caso B16, paso 1. Ejecutar toda la colección en orden sobre la base restablecida.
