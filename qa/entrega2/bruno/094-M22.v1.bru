meta {
  name: M22.v1 - PUT incompleto conserva el producto
  type: http
  seq: 94
}

get {
  url: {{base_url}}/api/catalogo-medicamentos/910001/
  body: none
  auth: none
}

headers {
  Content-Type: application/json
}

tests {
  test("HTTP 200", () => expect(res.getStatus()).to.equal(200));
  test("Valor nombre", () => expect(res.getBody()["nombre"]).to.deep.equal("Producto actualizado QA"));
  test("Valor stock", () => expect(res.getBody()["stock"]).to.deep.equal(20));
}

