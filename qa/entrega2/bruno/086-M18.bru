meta {
  name: M18 - Modificar stock y conservar otros campos
  type: http
  seq: 86
}

patch {
  url: {{base_url}}/api/catalogo-medicamentos/910001/
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "stock": 5
  }
}

tests {
  test("HTTP 200", () => expect(res.getStatus()).to.equal(200));
  test("Valor stock", () => expect(res.getBody()["stock"]).to.deep.equal(5));
  test("Valor dosis_mg", () => expect(res.getBody()["dosis_mg"]).to.deep.equal("1.00"));
}

docs {
