meta {
  name: B17 - Médico inexistente
  type: http
  seq: 40
}

post {
  url: {{base_url}}/api/bebes/
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "identificador": "QA-B17",
    "nombre_completo": "Paciente ficticio QA",
    "edad_meses": 0,
    "sexo": "F",
    "peso": 3.2,
    "fecha_nacimiento": "{{ayer}}",
    "medico_a_cargo": 999999
  }
}

tests {
  test("HTTP 400", () => expect(res.getStatus()).to.equal(400));
  test("Error medico_a_cargo", () => { expect(res.getBody()).to.have.property("medico_a_cargo"); expect(res.getBody()["medico_a_cargo"]).to.not.be.empty; });
}

docs {
  US-01 / B-CA4
  Negocio: integridad referencial
  Caso B17, paso 1. Ejecutar toda la colección en orden sobre la base restablecida.
}
