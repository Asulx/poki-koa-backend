meta {
  name: M15 - Stock obligatorio
  type: http
  seq: 81
}

post {
  url: {{base_url}}/api/catalogo-medicamentos/
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "nombre": "Producto ficticio M15",
    "principio_activo": "Sustancia QA",
    "dosis_mg": "1.00"
  }
}

tests {
  test("HTTP 400", () => expect(res.getStatus()).to.equal(400));
  test("Error stock", () => { expect(res.getBody()).to.have.property("stock"); expect(res.getBody()["stock"]).to.not.be.empty; });
}

docs {
  US-02 / M-CA1,M-CA3
  Equivalencia inválida
  Caso M15, paso 1. Ejecutar toda la colección en orden sobre la base restablecida.
}
