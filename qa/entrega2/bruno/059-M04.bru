meta {
  name: M04 - Nombre de 150 caracteres
  type: http
  seq: 59
}

post {
  url: {{base_url}}/api/catalogo-medicamentos/
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "nombre": "NNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNN",
    "principio_activo": "Sustancia QA",
    "dosis_mg": "1.00",
    "stock": 10
  }
}

tests {
  test("HTTP 201", () => expect(res.getStatus()).to.equal(201));
  test("Valor nombre", () => expect(res.getBody()["nombre"]).to.deep.equal("NNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNN"));
  test("Valor principio_activo", () => expect(res.getBody()["principio_activo"]).to.deep.equal("Sustancia QA"));
  test("Valor dosis_mg", () => expect(res.getBody()["dosis_mg"]).to.deep.equal("1.00"));
  test("Valor stock", () => expect(res.getBody()["stock"]).to.deep.equal(10));
}

docs {
  US-02 / M-CA1,M-CA3
  Límite superior
  Caso M04, paso 1. Ejecutar toda la colección en orden sobre la base restablecida.
}
