  type: http
  seq: 89
}

get {
  url: {{base_url}}/api/catalogo-medicamentos/910001/
  body: none
  auth: none
}

headers {
  Content-Type: application/json
}

tests {
  test("HTTP 200", () => expect(res.getStatus()).to.equal(200));
  test("Valor stock", () => expect(res.getBody()["stock"]).to.deep.equal(5));
  test("Valor nombre", () => expect(res.getBody()["nombre"]).to.deep.equal("Producto base QA"));
}

