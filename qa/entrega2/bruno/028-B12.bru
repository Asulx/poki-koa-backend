meta {
  name: B12 - Peso y fecha opcionales nulos
  type: http
  seq: 28
}

post {
  url: {{base_url}}/api/bebes/
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "identificador": "QA-B12",
    "nombre_completo": "Paciente ficticio QA",
    "edad_meses": 0,
    "sexo": "F",
    "peso": null,
    "fecha_nacimiento": null,
    "medico_a_cargo": 910001
  }
}

tests {
  test("HTTP 201", () => expect(res.getStatus()).to.equal(201));
  test("Valor identificador", () => expect(res.getBody()["identificador"]).to.deep.equal("QA-B12"));
  test("Valor nombre_completo", () => expect(res.getBody()["nombre_completo"]).to.deep.equal("Paciente ficticio QA"));
  test("Valor edad_meses", () => expect(res.getBody()["edad_meses"]).to.deep.equal(0));
  test("Valor sexo", () => expect(res.getBody()["sexo"]).to.deep.equal("F"));
  test("Valor peso", () => expect(res.getBody()["peso"]).to.deep.equal(null));
  test("Valor fecha_nacimiento", () => expect(res.getBody()["fecha_nacimiento"]).to.deep.equal(null));
  test("Valor medico_a_cargo", () => expect(res.getBody()["medico_a_cargo"]).to.deep.equal(910001));
}

docs {
  US-01 / B-CA3
  Equivalencia válida: ausencia opcional
  Caso B12, paso 1. Ejecutar toda la colección en orden sobre la base restablecida.
}
