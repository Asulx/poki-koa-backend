meta {
  name: B21 - Recuperar datos para edición y relaciones
  type: http
  seq: 48
}

get {
  url: {{base_url}}/api/bebes/910001/
  body: none
  auth: none
}

headers {
  Content-Type: application/json
}

tests {
  test("HTTP 200", () => expect(res.getStatus()).to.equal(200));
  test("Valor identificador", () => expect(res.getBody()["identificador"]).to.deep.equal("QA-BASE-1"));
  test("Valor medico_nombre", () => expect(res.getBody()["medico_nombre"]).to.deep.equal("Profesional ficticio QA"));
  test("Valor cuna", () => expect(res.getBody()["cuna"]).to.deep.equal("QA-CUNA-1"));
  test("Valor medicamentos.0.id", () => expect(res.getBody()["medicamentos"]["0"]["id"]).to.deep.equal(910001));
}

docs {
  US-01 / B-CA5
  Negocio: precarga de edición
  Caso B21, paso 1. Ejecutar toda la colección en orden sobre la base restablecida.
}
