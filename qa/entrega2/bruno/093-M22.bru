meta {
  name: M22 - PUT incompleto conserva el producto
  type: http
  seq: 93
}

put {
  url: {{base_url}}/api/catalogo-medicamentos/910001/
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "nombre": "NO GUARDAR"
  }
}

tests {
  test("HTTP 400", () => expect(res.getStatus()).to.equal(400));
  test("Error principio_activo", () => { expect(res.getBody()).to.have.property("principio_activo"); expect(res.getBody()["principio_activo"]).to.not.be.empty; });
  test("Error dosis_mg", () => { expect(res.getBody()).to.have.property("dosis_mg"); expect(res.getBody()["dosis_mg"]).to.not.be.empty; });
  test("Error stock", () => { expect(res.getBody()).to.have.property("stock"); expect(res.getBody()["stock"]).to.not.be.empty; });
}

docs {
  US-02 / M-CA2,M-CA3
  Negocio: campos requeridos
  Caso M22, paso 1. Ejecutar toda la colección en orden sobre la base restablecida.
}
