meta {
  name: B04 - Nombre vacío
  type: http
  seq: 7
}

post {
  url: {{base_url}}/api/bebes/
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "identificador": "QA-B04",
    "nombre_completo": "",
    "edad_meses": 0,
    "sexo": "F",
    "peso": 3.2,
    "fecha_nacimiento": "{{ayer}}",
    "medico_a_cargo": 910001
  }
}

tests {
  test("HTTP 400", () => expect(res.getStatus()).to.equal(400));
  test("Error nombre_completo", () => { expect(res.getBody()).to.have.property("nombre_completo"); expect(res.getBody()["nombre_completo"]).to.not.be.empty; });
}

docs {
  US-01 / B-CA2
  Equivalencia inválida
  Caso B04, paso 1. Ejecutar toda la colección en orden sobre la base restablecida.
}
