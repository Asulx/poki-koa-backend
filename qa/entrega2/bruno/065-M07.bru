meta {
  name: M07 - Principio activo de 151 caracteres
  type: http
  seq: 65
}

post {
  url: {{base_url}}/api/catalogo-medicamentos/
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "nombre": "Producto ficticio M07",
    "principio_activo": "PPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPP",
    "dosis_mg": "1.00",
    "stock": 10
  }
}

tests {
  test("HTTP 400", () => expect(res.getStatus()).to.equal(400));
  test("Error principio_activo", () => { expect(res.getBody()).to.have.property("principio_activo"); expect(res.getBody()["principio_activo"]).to.not.be.empty; });
}

docs {
  US-02 / M-CA1,M-CA3
  Límite excedido
  Caso M07, paso 1. Ejecutar toda la colección en orden sobre la base restablecida.
}
