meta {
  name: B19 - Edición inválida no guarda ni siquiera los campos válidos
  type: http
  seq: 45
}

patch {
  url: {{base_url}}/api/bebes/910001/
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "peso": 0,
    "diagnostico": "NO DEBE GUARDARSE"
  }
}

tests {
  test("HTTP 400", () => expect(res.getStatus()).to.equal(400));
  test("Error peso", () => { expect(res.getBody()).to.have.property("peso"); expect(res.getBody()["peso"]).to.not.be.empty; });
}

