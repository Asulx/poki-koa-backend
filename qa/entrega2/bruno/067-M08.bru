meta {
  name: M08 - Dosis no numérica
  type: http
  seq: 67
}

post {
  url: {{base_url}}/api/catalogo-medicamentos/
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "nombre": "Producto ficticio M08",
    "principio_activo": "Sustancia QA",
    "dosis_mg": "abc",
    "stock": 10
  }
}

tests {
  test("HTTP 400", () => expect(res.getStatus()).to.equal(400));
  test("Error dosis_mg", () => { expect(res.getBody()).to.have.property("dosis_mg"); expect(res.getBody()["dosis_mg"]).to.not.be.empty; });
}

docs {
  US-02 / M-CA1,M-CA3
  Equivalencia inválida
  Caso M08, paso 1. Ejecutar toda la colección en orden sobre la base restablecida.
}
