meta {
  name: M19 - Edición inválida no guarda cambios parciales
  type: http
  seq: 88
}

patch {
  url: {{base_url}}/api/catalogo-medicamentos/910001/
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "stock": -1,
    "nombre": "NO GUARDAR"
  }
}

tests {
  test("HTTP 400", () => expect(res.getStatus()).to.equal(400));
  test("Error stock", () => { expect(res.getBody()).to.have.property("stock"); expect(res.getBody()["stock"]).to.not.be.empty; });
}

docs {
  US-02 / M-CA2,M-CA3
  Negocio: rechazo atómico
  Caso M19, paso 1. Ejecutar toda la colección en orden sobre la base restablecida.
}
