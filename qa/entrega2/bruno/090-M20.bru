meta {
  name: M20 - Producto inexistente
  type: http
  seq: 90
}

get {
  url: {{base_url}}/api/catalogo-medicamentos/999999/
  body: none
  auth: none
}

headers {
  Content-Type: application/json
}

tests {
  test("HTTP 404", () => expect(res.getStatus()).to.equal(404));
  test("Error detail", () => { expect(res.getBody()).to.have.property("detail"); expect(res.getBody()["detail"]).to.not.be.empty; });
}

docs {
