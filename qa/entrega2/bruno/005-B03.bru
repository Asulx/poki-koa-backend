meta {
  name: B03 - Identificador ya registrado
  type: http
  seq: 5
}

post {
  url: {{base_url}}/api/bebes/
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "identificador": "QA-BASE-1",
    "nombre_completo": "Paciente ficticio QA",
    "edad_meses": 0,
    "sexo": "F",
    "peso": 3.2,
    "fecha_nacimiento": "{{ayer}}",
    "medico_a_cargo": 910001
  }
}

tests {
  test("HTTP 400", () => expect(res.getStatus()).to.equal(400));
  test("Error identificador", () => { expect(res.getBody()).to.have.property("identificador"); expect(res.getBody()["identificador"]).to.not.be.empty; });
}

docs {
  US-01 / B-CA2
  Negocio: unicidad
  Caso B03, paso 1. Ejecutar toda la colección en orden sobre la base restablecida.
}
