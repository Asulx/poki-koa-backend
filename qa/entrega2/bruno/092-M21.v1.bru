meta {
  name: M21.v1 - Modificar todos los campos
  type: http
  seq: 92
}

get {
  url: {{base_url}}/api/catalogo-medicamentos/910001/
  body: none
  auth: none
}

headers {
  Content-Type: application/json
}

tests {
  test("HTTP 200", () => expect(res.getStatus()).to.equal(200));
  test("Valor nombre", () => expect(res.getBody()["nombre"]).to.deep.equal("Producto actualizado QA"));
  test("Valor principio_activo", () => expect(res.getBody()["principio_activo"]).to.deep.equal("Sustancia nueva QA"));
  test("Valor dosis_mg", () => expect(res.getBody()["dosis_mg"]).to.deep.equal("2.50"));
  test("Valor stock", () => expect(res.getBody()["stock"]).to.deep.equal(20));
}

docs {
  US-02 / M-CA2
  Negocio: actualización completa
  Caso M21, paso 2. Ejecutar toda la colección en orden sobre la base restablecida.
}
