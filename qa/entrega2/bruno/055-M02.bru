meta {
  name: M02 - Nombre obligatorio
  type: http
  seq: 55
}

post {
  url: {{base_url}}/api/catalogo-medicamentos/
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "principio_activo": "Sustancia QA",
    "dosis_mg": "1.00",
    "stock": 10
  }
}

tests {
  test("HTTP 400", () => expect(res.getStatus()).to.equal(400));
  test("Error nombre", () => { expect(res.getBody()).to.have.property("nombre"); expect(res.getBody()["nombre"]).to.not.be.empty; });
}

docs {
  US-02 / M-CA1,M-CA3
  Equivalencia inválida
  Caso M02, paso 1. Ejecutar toda la colección en orden sobre la base restablecida.
}
