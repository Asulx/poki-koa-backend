meta {
  name: B14 - Fecha de nacimiento: hoy
  type: http
  seq: 32
}

post {
  url: {{base_url}}/api/bebes/
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "identificador": "QA-B14",
    "nombre_completo": "Paciente ficticio QA",
    "edad_meses": 0,
    "sexo": "F",
    "peso": 3.2,
    "fecha_nacimiento": "{{hoy}}",
    "medico_a_cargo": 910001
  }
}

tests {
  test("HTTP 201", () => expect(res.getStatus()).to.equal(201));
  test("Valor identificador", () => expect(res.getBody()["identificador"]).to.deep.equal("QA-B14"));
  test("Valor nombre_completo", () => expect(res.getBody()["nombre_completo"]).to.deep.equal("Paciente ficticio QA"));
  test("Valor edad_meses", () => expect(res.getBody()["edad_meses"]).to.deep.equal(0));
  test("Valor sexo", () => expect(res.getBody()["sexo"]).to.deep.equal("F"));
  test("Valor peso", () => expect(res.getBody()["peso"]).to.deep.equal(3.2));
  test("Valor fecha_nacimiento", () => expect(res.getBody()["fecha_nacimiento"]).to.deep.equal(bru.interpolate("{{hoy}}")));
  test("Valor medico_a_cargo", () => expect(res.getBody()["medico_a_cargo"]).to.deep.equal(910001));
}

docs {
  US-01 / B-CA3
  Límite temporal
  Caso B14, paso 1. Ejecutar toda la colección en orden sobre la base restablecida.
}
