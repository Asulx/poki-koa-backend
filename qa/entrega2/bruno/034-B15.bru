meta {
  name: B15 - Fecha de nacimiento: manana
  type: http
  seq: 34
}

post {
  url: {{base_url}}/api/bebes/
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "identificador": "QA-B15",
    "nombre_completo": "Paciente ficticio QA",
    "edad_meses": 0,
    "sexo": "F",
    "peso": 3.2,
    "fecha_nacimiento": "{{manana}}",
    "medico_a_cargo": 910001
  }
}

tests {
  test("HTTP 400", () => expect(res.getStatus()).to.equal(400));
  test("Error fecha_nacimiento", () => { expect(res.getBody()).to.have.property("fecha_nacimiento"); expect(res.getBody()["fecha_nacimiento"]).to.not.be.empty; });
}

docs {
  US-01 / B-CA3
  Límite temporal
  Caso B15, paso 1. Ejecutar toda la colección en orden sobre la base restablecida.
}
