meta {
  name: B10 - Peso 0
  type: http
  seq: 23
}

post {
  url: {{base_url}}/api/bebes/
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "identificador": "QA-B10",
    "nombre_completo": "Paciente ficticio QA",
    "edad_meses": 0,
    "sexo": "F",
    "peso": 0,
    "fecha_nacimiento": "{{ayer}}",
    "medico_a_cargo": 910001
  }
}

tests {
  test("HTTP 400", () => expect(res.getStatus()).to.equal(400));
  test("Error peso", () => { expect(res.getBody()).to.have.property("peso"); expect(res.getBody()["peso"]).to.not.be.empty; });
}

docs {
  US-01 / B-CA3
  Límite inferior: peso > 0
  Caso B10, paso 1. Ejecutar toda la colección en orden sobre la base restablecida.
}
