### M17 paso 1: Consulta para precarga
# Esperado: HTTP 200; {"equals": {"nombre": "Producto base QA", "principio_activo": "Sustancia QA", "dosis_mg": "1.00", "stock": 10}}
GET {{base_url}}/api/catalogo-medicamentos/910001/
Content-Type: application/json


### M18 paso 1: Modificar stock y conservar otros campos
# Esperado: HTTP 200; {"equals": {"stock": 5, "dosis_mg": "1.00"}}
PATCH {{base_url}}/api/catalogo-medicamentos/910001/
Content-Type: application/json

{
  "stock": 5
}

### M18 paso 2: Modificar stock y conservar otros campos
# Esperado: HTTP 200; {"equals": {"stock": 5, "nombre": "Producto base QA"}}
GET {{base_url}}/api/catalogo-medicamentos/910001/
Content-Type: application/json


### M19 paso 1: Edición inválida no guarda cambios parciales
# Esperado: HTTP 400; {"keys": ["stock"]}
PATCH {{base_url}}/api/catalogo-medicamentos/910001/
Content-Type: application/json

{
  "stock": -1,
  "nombre": "NO GUARDAR"
}

### M19 paso 2: Edición inválida no guarda cambios parciales
# Esperado: HTTP 200; {"equals": {"stock": 5, "nombre": "Producto base QA"}}
GET {{base_url}}/api/catalogo-medicamentos/910001/
Content-Type: application/json


### M20 paso 1: Producto inexistente
# Esperado: HTTP 404; {"keys": ["detail"]}
GET {{base_url}}/api/catalogo-medicamentos/999999/
Content-Type: application/json


### M21 paso 1: Modificar todos los campos
# Esperado: HTTP 200; {}
PUT {{base_url}}/api/catalogo-medicamentos/910001/
Content-Type: application/json

{
  "nombre": "Producto actualizado QA",
  "principio_activo": "Sustancia nueva QA",
  "dosis_mg": "2.50",
  "stock": 20
}

### M21 paso 2: Modificar todos los campos
