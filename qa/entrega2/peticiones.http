POST {{base_url}}/api/catalogo-medicamentos/
Content-Type: application/json

{
  "nombre": "Producto ficticio M10",
  "principio_activo": "Sustancia QA",
  "dosis_mg": "0.01",
  "stock": 10
}

### M10 paso 2: Dosis mínima 0.01 mg
# Esperado: HTTP 200; {"length": 5}
GET {{base_url}}/api/catalogo-medicamentos/
Content-Type: application/json


