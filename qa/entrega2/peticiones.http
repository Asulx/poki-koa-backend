GET {{base_url}}/api/catalogo-medicamentos/910001/
Content-Type: application/json


### M22 paso 1: PUT incompleto conserva el producto
# Esperado: HTTP 400; {"keys": ["principio_activo", "dosis_mg", "stock"]}
PUT {{base_url}}/api/catalogo-medicamentos/910001/
Content-Type: application/json

{
  "nombre": "NO GUARDAR"
}

### M22 paso 2: PUT incompleto conserva el producto
# Esperado: HTTP 200; {"equals": {"nombre": "Producto actualizado QA", "stock": 20}}
GET {{base_url}}/api/catalogo-medicamentos/910001/
Content-Type: application/json

